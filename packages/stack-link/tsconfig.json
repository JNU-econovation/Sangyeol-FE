{
  "extends": "../../tsconfig.json",
  "tsconfigRootDir": "../../.",
  "compilerOptions": {
    "composite": false,
    "outDir": "dist",
    "baseUrl": ".",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*",
        "./public/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@models/*": [
        "./src/models/*"
      ],
      "@context/*": [
        "./src/context/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}